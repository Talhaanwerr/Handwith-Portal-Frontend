# ─── Public (safe to expose to the browser) ───────────────────────────────────
# NEVER put private secrets, DB URLs, JWT signing keys, or API private keys here.
NEXT_PUBLIC_APP_NAME="SaaS Boilerplate"
NEXT_PUBLIC_APP_URL="http://localhost:3007"
# Same-origin path so the refresh cookie is first-party (not blocked as third-party).
NEXT_PUBLIC_API_URL="/api/v1"

# ─── Server-only ──────────────────────────────────────────────────────────────
# NestJS origin the Next.js /api/v1 proxy forwards to (no /api/v1 suffix).
API_PROXY_TARGET="https://handwith-portal-backend-production.up.railway.app"
# Local backend instead of Railway:
# NEXT_PUBLIC_API_URL="http://localhost:4601/api/v1"
# API_PROXY_TARGET=
